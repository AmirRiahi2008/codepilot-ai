# Runtime
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database / Redis
DATABASE_URL=postgresql://codepilot:codepilot@localhost:5432/codepilot?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
COOKIE_NAME=codepilot_session

# Internal API shared secret for the analysis worker
WORKER_SECRET=replace-this-with-another-long-random-secret

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/github/callback

# AI - optional for the first local run
# For OpenAI use https://api.openai.com/v1 and a model supported by your account.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Worker
WORKER_CONCURRENCY=2
MAX_REPOSITORY_FILE_BYTES=300000
MAX_REPOSITORY_FILES=1500
