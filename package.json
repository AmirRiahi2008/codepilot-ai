{
  "name": "codepilot-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run db:generate && npm run build:api && npm run build:worker && npm run build:web",
    "build:api": "npm --workspace apps/api run build",
    "build:worker": "npm --workspace apps/worker run build",
    "build:web": "npm --workspace apps/web run build",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:push": "prisma db push --schema apps/api/prisma/schema.prisma",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck:api && npm run typecheck:worker && npm run typecheck:web",
    "typecheck:api": "npm --workspace apps/api run typecheck",
    "typecheck:worker": "npm --workspace apps/worker run typecheck",
    "typecheck:web": "npm --workspace apps/web run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prisma": "^7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "ioredis": "^6.0.0"
  }
}
